{
  "name": "workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --webpack",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:lenient": "eslint . --max-warnings 200",
    "lint:dev": "ESLINT_CONFIG_FILE=eslint.config.dev.mjs eslint . --max-warnings 100",
    "type-check": "tsc --noEmit",
    "validate-react": "node scripts/validate-react-imports.js",
    "validate-filenames": "node scripts/validate-filenames.mjs",
    "validate-env": "node scripts/validate-env.js",
    "validate-seo:sitemap": "node scripts/validate-sitemap.mjs",
    "validate-seo:sitemap-source": "node scripts/validate-sitemap-source.mjs",
    "validate-seo:structured": "node scripts/validate-structured-data.mjs",
    "validate": "npm run validate-env && npm run validate-filenames && npm run lint:strict && npm run type-check && npm run validate-react",
    "prebuild": "npm run validate && npm run generate-og-static",
    "test:e2e": "npx playwright test",
    "test:e2e:dev": "npm run test:e2e:prepare && cross-env PLAYWRIGHT_USE_DEV=true PW_BASE_URL=http://localhost:3000 npx playwright test",
    "test:e2e:prepare": "node scripts/generate-e2e-fixtures.js && node scripts/generate-tiny-webm.js",
    "test:e2e:prepare:video": "node scripts/generate-tiny-webm.js",
    "test:e2e:prepare:docx": "node scripts/generate-docx-fixture.js",
    "test:e2e:baseline:pagedjs": "node scripts/generate-pagedjs-baseline.js",
    "test:e2e:headed": "npx playwright test --headed --project=chromium",
    "test:e2e:all": "npm run test:e2e:prepare && npx playwright test",
    "generate-og-static": "node scripts/generate-og-static.mjs",
    "browserslist:update": "npx update-browserslist-db@latest",
    "postinstall": "npx update-browserslist-db@latest || true"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@hello-pangea/dnd": "^18.0.1",
    "@imgly/background-removal": "^1.7.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shadcn/ui": "^0.0.4",
    "@uiw/react-codemirror": "^4.23.7",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "canvas": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "diff": "^8.0.2",
    "dompurify": "^3.1.7",
    "es5-ext": "^0.10.64",
    "exif-js": "^2.3.0",
    "fast-xml-parser": "^5.3.2",
    "fflate": "^0.8.2",
    "framer-motion": "^12.23.25",
    "glob": "^11.0.3",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.556.0",
    "mammoth": "^1.9.1",
    "marked": "^17.0.1",
    "next": "^16.2.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.5",
    "react-dropzone": "^14.3.8",
    "recharts": "^3.5.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tesseract.js": "^6.0.1",
    "tinycolor2": "^1.6.0",
    "turndown": "^7.2.2",
    "uuid": "^14.0.0",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.12.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "cross-env": "^7.0.3",
    "docx": "^8.5.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.4",
    "googleapis": "^170.0.0",
    "lightningcss": "^1.31.1",
    "pagedjs": "^0.4.3",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.59.1",
    "pngjs": "^6.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.13"
    }
  }
}
