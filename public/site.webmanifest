{
  "name": "easy-pdf - Privacy-First PDF Tools",
  "short_name": "easy-pdf",
  "description": "100% client-side PDF tools for secure document processing. Merge, split, compress, convert PDFs directly in your browser.",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#000000",
  "theme_color": "#1e40af",
  "categories": ["business", "productivity", "utilities"],
  "lang": "en-IN",
  "scope": "/",
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
