{
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build-ignore-warnings": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:strict": "next lint --max-warnings 0",
    "lint:lenient": "next lint --max-warnings 200",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint:strict && npm run type-check && npm run validate-react",
    "validate-lenient": "npm run lint:lenient && npm run type-check && npm run validate-react",
    "validate-react": "node scripts/validate-react-imports.js",
    "prebuild": "npm run validate",
    "test-build": "npm run validate-lenient && next build"
  }
}